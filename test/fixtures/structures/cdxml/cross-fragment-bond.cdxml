<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE CDXML SYSTEM "http://www.cambridgesoft.com/xml/cdxml.dtd">
<CDXML CreationProgram="Synthetic fixture (hand-written, not ChemDraw output)" Name="bond leaves its fragment">
  <fonttable>
    <font id="1" charset="iso-8859-1" name="Arial"/>
  </fonttable>
  <page id="1" BoundingBox="60 90 160 110">
    <fragment id="2" Name="first fragment">
      <n id="11" p="80.00 100.00"/>
      <n id="12" p="94.00 100.00"/>
      <b id="21" B="11" E="12" Order="1"/>
      <!-- id 21 belongs to the second fragment; a drawing may not bond across it -->
      <b id="22" B="12" E="21" Order="1"/>
    </fragment>
    <fragment id="3" Name="second fragment">
      <n id="21" p="140.00 100.00">
        <t id="22" p="140.00 100.00"><s font="1" size="10">Cl</s></t>
      </n>
      <n id="23" p="154.00 100.00"/>
      <b id="24" B="21" E="23" Order="1"/>
    </fragment>
  </page>
</CDXML>
