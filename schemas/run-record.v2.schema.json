{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodechem.studio/schemas/run-record.v2.schema.json",
  "title": "NodeChem Studio record (schemaVersion 2)",
  "description": "Version 2 of the record contract. A record is one of two things: a run NodeChem performed (the v1 envelope, kept verbatim) or a result another program computed (kind \"imported\"). The union is explicit, so an imported number can live beside the runs without being read as one. v2 is a superset of v1: every v1 document validates unchanged, and the run branch still declares schemaVersion 1 because runs are still written to the v1 contract.",
  "x-nodechem": {
    "schemaVersion": 2,
    "recordFile": "run.json",
    "producedBy": [
      "electron/runner/runManager.js",
      "electron/runner/clusterFiles.js",
      "bin/ncs.js (ncs record import)"
    ],
    "supersedes": 1,
    "migration": "v1 is still exported with --schema-version 1 and only ever gains optional properties: a run record keeps schemaVersion 1 and validates here, an imported record declares schemaVersion 2 and kind \"imported\", which v1 refuses. Nothing is rewritten, and no old document is re-versioned."
  },
  "oneOf": [
    {
      "$ref": "#/$defs/runRecord"
    },
    {
      "$ref": "#/$defs/importedRecord"
    }
  ],
  "$defs": {
    "structureIntegrity": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "match",
            "tautomer-changed",
            "stereo-changed",
            "connectivity-changed",
            "composition-changed",
            "inconclusive",
            "not-applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasonText": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": "string",
          "enum": [
            "warn",
            "fail"
          ]
        },
        "before": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "after": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "comparisons": {
          "type": "object",
          "additionalProperties": true
        },
        "origin": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "dp4Result": {
      "type": "object",
      "description": "Issue 165: the object dp4.js returned, as the analyse block recorded it. `available` is required so a record cannot carry an empty comparison; on a refusal it is false with the code and the sentence that names the precondition. The rest is open because the result is a table (candidates, per-nucleus deviations, the fit each nucleus used) whose columns belong to the DP4+ procedure, not to this envelope.",
      "required": ["available"],
      "additionalProperties": true,
      "properties": {
        "available": { "type": "boolean" },
        "code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "expression": { "type": "string" },
        "notComputed": { "type": ["string", "null"] }
      }
    },
    "spectrumAssignment": {
      "type": "object",
      "description": "Issue 348: the Boltzmann-averaged spectrum of one candidate, its comparison with a measured trace and the ranking of candidates, as `spectrumAssignment.js` returned it. `available` is required so a record cannot carry an empty assignment; a refusal is false with the code and the sentence that names the precondition. The rest is open because the result carries per-candidate curves, band tables and the populations the score depended on.",
      "required": ["available"],
      "additionalProperties": true,
      "properties": {
        "available": { "type": "boolean" },
        "code": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "spectrumOverlay": {
      "type": "object",
      "description": "Issue 184: a measured spectrum imported beside the computed sticks. The record carries the file's own points, its sha256, and the column names and units the file declared, so a report can name and redraw exactly the trace it was compared against. Absent when no measured trace was imported — never an empty curve.",
      "required": ["source", "sha256", "columns", "units", "points"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "columns": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "string", "minLength": 1, "maxLength": 64 },
            "y": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "units": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "string", "minLength": 1, "maxLength": 32 },
            "y": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "runRecord": {
      "type": "object",
      "required": [
        "id",
        "status",
        "dryRun",
        "title",
        "inputName",
        "outputName",
        "outputFile",
        "outputSource",
        "truncated",
        "executable",
        "scratchDir",
        "checkpointHandoff",
        "provenance",
        "startedAt",
        "finishedAt",
        "exitCode",
        "parsed",
        "gates",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1,
          "description": "Record contract version. Optional because records written before the contract was published, and cluster-import records, do not carry it."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 124,
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Run id, also the run folder name."
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "needs-review",
            "cancelled",
            "timed out"
          ],
          "description": "`timed out` is the queue giving up at the task's wall-clock limit. It is deliberately not `failed`: the engine never reported a verdict, so a report can tell \"the engine said no\" from \"we stopped waiting\"."
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "description": "Engine id: gaussian, xtb, orca, psi4, pyscf, or a plugin id. Absent on cluster-import records, which do not run anything locally."
        },
        "argv": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "The argument vector the runner used (without the executable)."
        },
        "dryRun": {
          "type": "boolean",
          "description": "True when the output is a labelled fixture, not a calculation."
        },
        "title": {
          "type": "string"
        },
        "inputName": {
          "type": "string",
          "minLength": 1
        },
        "outputName": {
          "type": "string",
          "minLength": 1
        },
        "outputFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputSource": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the parsed text came from: file, stdout, fixture, cluster-import."
        },
        "truncated": {
          "type": "boolean"
        },
        "outputBytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/outputBytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "scratchDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpointHandoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/checkpointHandoff"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Absent on cluster-import records."
        },
        "outputSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Absent on cluster-import records."
        },
        "app": {
          "anyOf": [
            {
              "$ref": "#/$defs/app"
            },
            {
              "type": "null"
            }
          ],
          "description": "App version and commit the run was written by. Absent on cluster-import records."
        },
        "conformer": {
          "anyOf": [
            {
              "$ref": "#/$defs/conformer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when the run was built on one member of a conformer ensemble."
        },
        "record": {
          "$ref": "#/$defs/recordIdentity",
          "description": "Issue 193: the dataset record this run ran. Absent (not null) for a single-structure block, and never filled in with a synthetic id."
        },
        "series": {
          "$ref": "#/$defs/seriesDerivation",
          "description": "Issue 193: the repeat unit a generated member was expanded from. Absent unless the record came from a series block."
        },
        "spectrumOverlay": {
          "$ref": "#/$defs/spectrumOverlay",
          "description": "Issue 184: the measured trace imported beside this run's computed sticks. Optional, and absent (not null) when no trace was imported."
        },
        "dp4": {
          "$ref": "#/$defs/dp4Result",
          "description": "Issue 165: the DP4+ probabilities a derived analyse block recorded. Optional, and absent (not null) on every run that computed no comparison."
        },
        "spectrumAssignment": {
          "$ref": "#/$defs/spectrumAssignment",
          "description": "Issue 348: the Boltzmann-averaged VCD/IR/Raman spectrum of one candidate, its comparison with a measured trace and the ranking of candidates. Optional, and absent (not null) on every run that computed no assignment."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "parsed": {
          "anyOf": [
            {
              "$ref": "#/$defs/parsed"
            },
            {
              "type": "null"
            }
          ],
          "description": "The engine's parse. The canonical keys below are the ones consumers may rely on; engine-specific evidence is additional and open."
        },
        "gates": {
          "anyOf": [
            {
              "$ref": "#/$defs/gates"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/cache"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed-array cache written for a non-dry run. Absent on records that never reached finish()."
        },
        "structureIntegrity": {
          "anyOf": [
            {
              "$ref": "#/$defs/structureIntegrity"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR 0003 §3.6: what the final geometry actually is. `inconclusive` is a real answer and is never a pass. Absent on records that never reached finish()."
        },
        "wavefunction": {
          "anyOf": [
            {
              "$ref": "#/$defs/wavefunction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Issue 334: the wavefunction files the run folder carries (a converted checkpoint, Molden/WFN/WFX, a cube) with their kind, file name, SHA-256 and byte count, plus the counts the dataset export reads. Absent when the run carried none."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeout"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when the run was stopped at its wall-clock limit (issue 177). A run that finished inside its limit carries no such key, so its record is unchanged."
        }
      }
    },
    "importedRecord": {
      "type": "object",
      "description": "A number another program computed. Deliberately not run-shaped: no status, output, gates or exit code, because none of those happened here. `sourceSha256` proves which file the number came from, not that the calculation is right.",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "program",
        "version",
        "method",
        "basis",
        "energy",
        "sourceSha256",
        "importedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2,
          "description": "The contract this record was written for. Imported records are a v2 shape; a run record keeps declaring 1."
        },
        "kind": {
          "type": "string",
          "const": "imported"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 124,
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Record id, also the folder name when it lives in a run folder."
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "description": "The program that computed the number, as its own splash screen names it (for example \"Spartan '26\")."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The program version. Required: an unversioned number cannot be reproduced."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "The level of theory, in the source program's own vocabulary (for example \"ωB97X-D3\")."
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "description": "The basis set, or the method-defined sentinel the app already uses when a method carries its own basis."
        },
        "energy": {
          "type": "number",
          "description": "The total energy in Hartree. There is no unit field: Hartree is the contract."
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the file the number was read from. It identifies the file; it does not certify the calculation."
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "description": "The source file's name, when the importer saw a path. Optional: a hash supplied by another host has no name here."
        },
        "title": {
          "type": "string",
          "description": "What the number is, for a report row. Optional."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Free text from the importer. It is not evidence."
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When this record was written, not when the other program ran."
        }
      }
    },
    "timeout": {
      "type": "object",
      "description": "What a run stopped at its wall-clock limit recorded (issue 177): the limit it was given, the measured elapsed time, and the last line the engine wrote. `parsed` and `gates` are null on such a run — a log cut off mid-block is not a result.",
      "required": [
        "limitSeconds",
        "elapsedSeconds",
        "lastOutput"
      ],
      "additionalProperties": false,
      "properties": {
        "limitSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "The wall-clock limit the task was given, in seconds."
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Measured from the moment the engine was launched to the moment the limit fired, to 0.1 s."
        },
        "lastOutput": {
          "type": [
            "string",
            "null"
          ],
          "description": "The last non-empty line the engine wrote before it was stopped."
        },
        "tree": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "escalated",
                "survived"
              ],
              "additionalProperties": false,
              "properties": {
                "escalated": {
                  "type": "boolean",
                  "description": "SIGTERM did not stop the tree inside the grace period, so SIGKILL was sent."
                },
                "survived": {
                  "type": "boolean",
                  "description": "The tree was still alive after SIGKILL."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "What the process-tree kill reported; null when the runner could not report it."
        }
      }
    },
    "outputBytes": {
      "type": "object",
      "required": [
        "size",
        "bytesRead",
        "truncated",
        "windows"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "bytesRead": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "start",
              "end",
              "bytes",
              "supplied"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "supplied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "checkpointHandoff": {
      "type": "object",
      "required": [
        "file",
        "bytes",
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sourceRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "fixture",
            "copy"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "app": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "conformer": {
      "type": "object",
      "required": [
        "nodeId",
        "title",
        "generator",
        "id",
        "relativeKcal",
        "population",
        "protomer",
        "spreadKcal"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "relativeKcal": {
          "type": [
            "number",
            "null"
          ]
        },
        "population": {
          "type": [
            "number",
            "null"
          ]
        },
        "protomer": {
          "type": "string"
        },
        "tautomer": {
          "type": "string",
          "maxLength": 16,
          "description": "Issue 226: the tautomer candidate label (t1, t2, ...) when the run started from a tautomer enumeration. Absent for a conformer run."
        },
        "produces": {
          "type": "string",
          "enum": ["tautomers"],
          "description": "Issue 226: present only when the ensemble enumerated tautomers, not conformers."
        },
        "spreadKcal": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "recordIdentity": {
      "type": "object",
      "description": "Issue 193: the record a run executed, copied from the queued task. datasetId is copied from the input block that handed the record out and is omitted when no block names it.",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "seriesDerivation": {
      "type": "object",
      "description": "Issue 193: how a generated member was derived. n is the member number (1-based) and count the number of members in the block; linkage is the rule the builder actually applied, with 1-based atom indices.",
      "required": [
        "parentId",
        "n",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "linkage": {
          "type": "object",
          "required": [
            "donor",
            "acceptor",
            "bondLengthAngstrom",
            "leaving"
          ],
          "additionalProperties": false,
          "properties": {
            "donor": {
              "type": "integer",
              "minimum": 1
            },
            "acceptor": {
              "type": "integer",
              "minimum": 1
            },
            "bondLengthAngstrom": {
              "type": [
                "number",
                "null"
              ]
            },
            "leaving": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Open object: local runs and cluster imports write different keys, and each engine adds its own method block.",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fixture",
            "calculation"
          ]
        },
        "jobType": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "object",
            "null"
          ],
          "description": "The engine's method block. Gaussian writes functional/basis/grid/scf/td; xTB writes hamiltonian/optLevel/argv.",
          "additionalProperties": true
        },
        "solvation": {
          "type": [
            "string",
            "null"
          ]
        },
        "ecp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ecp"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": "object",
          "required": [
            "name",
            "bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/provenanceOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "xtb": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "parametersPath": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "psi4": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "stderr": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "orca": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
