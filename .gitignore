node_modules/
dist/
release/
runs/
*.log
electron/build-info.json
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# A worktree may symlink the shared install; the slash form above does not match
# a symlink, so both spellings are ignored.
node_modules

# Real engine outputs used as test fixtures (see the README beside each folder).
# The blanket *.log rule above drops them from a commit without a word, which is
# how a fixture test passes locally and fails in CI with ENOENT — so the negation
# covers every fixture folder rather than the one that existed when it was written.
!test/fixtures/**/*.log
!test/fixtures/**/*.out

# Dry-run output written by `ncs run` in the working directory
ncs-runs/

# Python client bytecode (clients/python)
__pycache__/
*.pyc

# The Python client's fixture folder is named `runs/`, like app output. Keep the
# committed fixture even though the line above ignores run folders generally.
!clients/python/tests/fixtures/runs/
!clients/python/tests/fixtures/runs/**

# Local agent plans and scratch notes
.hermes/
