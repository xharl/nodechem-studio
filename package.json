{
  "name": "nodechem-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NodeChem Studio \u2014 node-first desktop workbench for Gaussian 16 and xTB workflows (local runner, no telemetry)",
  "license": "Apache-2.0",
  "author": "xharl",
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "build": "node scripts/stamp-build-info.mjs && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-syntax.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "bundle": "bash scripts/package-bundle.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.xharl.nodechemstudio",
    "productName": "NodeChem Studio",
    "copyright": "Copyright \u00a9 2026 Xavier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/shared/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "ncs",
        "name": "NodeChem Studio project",
        "description": "NodeChem Studio project document",
        "mimeType": "application/x-nodechem-studio-project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "executableArgs": [],
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "nodechem-studio"
        }
      },
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "NodeChem Studio"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xharl/nodechem-studio.git"
  },
  "homepage": "https://github.com/xharl/nodechem-studio#readme",
  "bugs": {
    "url": "https://github.com/xharl/nodechem-studio/issues"
  },
  "keywords": [
    "computational-chemistry",
    "gaussian",
    "xtb",
    "quantum-chemistry",
    "electron",
    "workflow",
    "molecular-dynamics"
  ],
  "desktopName": "nodechem-studio",
  "bin": {
    "ncs": "bin/ncs.js"
  }
}
